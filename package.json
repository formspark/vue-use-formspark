{
  "name": "@formspark/vue-use-formspark",
  "description": "Vue composition API functions for Formspark",
  "private": false,
  "version": "0.2.1",
  "author": "Bjorn Krols (https://formspark.io)",
  "license": "MIT",
  "keywords": [
    "formspark",
    "vue"
  ],
  "homepage": "https://github.com/formspark/vue-use-formspark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formspark/vue-use-formspark.git"
  },
  "bugs": {
    "url": "https://github.com/formspark/vue-use-formspark/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write . --ignore-path .gitignore",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
